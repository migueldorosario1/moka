{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "regions": [
    "gru1"
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/painel",
      "destination": "https://43.156.151.165.sslip.io/painel"
    },
    {
      "source": "/api/pontos/:path*",
      "destination": "https://43.156.151.165.sslip.io/:path*"
    }
  ]
}