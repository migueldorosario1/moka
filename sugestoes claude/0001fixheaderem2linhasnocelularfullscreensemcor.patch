index 6fccc48..4917013 100644
--- a/apps/web/src/components/Reader.tsx
+++ b/apps/web/src/components/Reader.tsx
@@ -200,6 +200,35 @@ export function Reader({
   const [isFullscreen, setIsFullscreen] = useState(false);
   const [menuVisible, setMenuVisible] = useState(true);
   const [bookmarksOpen, setBookmarksOpen] = useState(false);
+  // Fileira scrollável de botões do header (pra indicar overflow com fade).
+  const rowScrollRef = useRef<HTMLDivElement>(null);
+
+  /**
+   * Marca nas bordas da fileira de botões quando há mais botões escondidos
+   * (fade via CSS [data-fade]). Sem isso, overflow-x + scrollbar oculta
+   * faz os botões "sumirem" sem nenhuma pista visual.
+   */
+  const updateRowFade = () => {
+    const el = rowScrollRef.current;
+    if (!el) return;
+    const canLeft = el.scrollLeft > 2;
+    const canRight = el.scrollLeft + el.clientWidth < el.scrollWidth - 2;
+    el.dataset.fade =
+      canLeft && canRight ? "both" : canLeft ? "left" : canRight ? "right" : "none";
+  };
+
+  // Reavalia o fade a cada render (botões aparecem/somem: ⏹ TTS, 🌐/🧠 PDF)
+  // e quando o container muda de tamanho (rotação, resize, fullscreen).
+  useEffect(() => {
+    updateRowFade();
+  });
+  useEffect(() => {
+    const el = rowScrollRef.current;
+    if (!el || typeof ResizeObserver === "undefined") return;
+    const ro = new ResizeObserver(updateRowFade);
+    ro.observe(el);
+    return () => ro.disconnect();
+  }, []);
 
   /** Entra/sai do modo tela cheia (só a página do livro visível). */
   const toggleFullscreen = () => {
@@ -949,7 +978,7 @@ export function Reader({
